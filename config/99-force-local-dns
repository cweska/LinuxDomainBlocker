#!/bin/bash
#
# NetworkManager dispatcher script to force all connections to use local dnsmasq
# This prevents bypassing the domain blocker when connecting to new networks
#
# Install location: /etc/NetworkManager/dispatcher.d/99-force-local-dns
#

INTERFACE="$1"
ACTION="$2"

# Log file for debugging
LOG_FILE="/var/log/domain-blocker-dispatcher.log"

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "${LOG_FILE}"
}

# Only act on connection up events
case "$ACTION" in
    up|dhcp4-change|dhcp6-change|connectivity-change)
        # Get the connection name
        CONNECTION_NAME="${CONNECTION_ID:-unknown}"
        
        log_message "Network event: ${ACTION} on ${INTERFACE} (${CONNECTION_NAME})"
        
        # Skip loopback interface
        if [ "$INTERFACE" = "lo" ]; then
            exit 0
        fi
        
        # Force DNS settings on this connection
        if [ -n "$CONNECTION_ID" ]; then
            # Set IPv4 DNS to localhost (dnsmasq)
            nmcli connection modify "$CONNECTION_ID" ipv4.dns "127.0.0.1" 2>/dev/null
            nmcli connection modify "$CONNECTION_ID" ipv4.ignore-auto-dns yes 2>/dev/null
            
            # Set IPv6 DNS to localhost (dnsmasq)
            nmcli connection modify "$CONNECTION_ID" ipv6.dns "::1" 2>/dev/null
            nmcli connection modify "$CONNECTION_ID" ipv6.ignore-auto-dns yes 2>/dev/null
            
            log_message "Forced DNS settings on connection: ${CONNECTION_NAME}"
            
            # Apply the changes to the active connection
            # Use 'nmcli device reapply' which is safer than down/up (no disconnect)
            if [ "$ACTION" = "dhcp4-change" ] || [ "$ACTION" = "dhcp6-change" ]; then
                # Don't reapply on DHCP changes to avoid infinite loops
                log_message "Skipping reapply on DHCP change event"
            else
                # For 'up' and 'connectivity-change' events, apply the DNS settings immediately
                if nmcli device reapply "$INTERFACE" 2>/dev/null; then
                    log_message "Applied DNS settings to device: ${INTERFACE}"
                else
                    log_message "Warning: Failed to reapply settings to ${INTERFACE} (may already be applied)"
                fi
            fi
        fi
        ;;
    *)
        # Ignore other events (down, pre-up, etc.)
        ;;
esac

exit 0

